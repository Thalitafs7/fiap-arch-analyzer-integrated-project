generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalysisJob {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  status    String   @default("RECEIVED") // RECEIVED, UPLOADED, QUEUED, ERROR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
